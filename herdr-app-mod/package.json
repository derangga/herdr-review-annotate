{
  "name": "herdr-review-mod",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=esm --target=es2022 --external:gpui-kit --external:gpui-base --external:herdr --outfile=out/main.js",
    "test": "node --experimental-strip-types --test 'test/*.test.ts'",
    "typecheck": "tsc -p .",
    "setup-types": "cp \"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/gpui-kit.d.ts\" \"${HERDR_APP_HOME:-$HOME/.config/herdr-app}/herdr.d.ts\" ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
